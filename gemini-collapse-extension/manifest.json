{
  "manifest_version": 3,
  "name": "Gemini Response Collapser",
  "version": "1.2",
  "description": "Nasconde le risposte di Gemini dentro un menu a tendina.",
  "permissions": [],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_end"
    }
  ]
}
